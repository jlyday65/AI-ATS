GINA_ATS_BASE_URL=https://lyday-gina-backend-production.up.railway.app
RELAY_SECRET=
GINA_ATS_APP_PASSWORD=
GINA_ATS_API_KEY=

# SignalHire workspace mode: test | live (UI on /ats can override via store + cookies)
ATS_MODE=test

# Required when ATS_MODE=live — password re-entry after idle timeout (5/10/15 min)
SIGNALHIRE_APP_PASSWORD=
# Optional override for signing session cookies (defaults to RELAY_SECRET)
SIGNALHIRE_SESSION_SECRET=

# --- Dual data tracks (see docs/DATA-PROVIDERS.md) ---
# Job market intel: Coresignal Multi-source Jobs + Bright Data Jobs → POST /api/maria/market
# Candidate sourcing: Coresignal Employee (+ optional Bright Data LinkedIn URLs) → POST /api/maria/source
CORESIGNAL_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_JOBS_DATASET_ID=gd_lpfll7v5hcqtkxl6l
BRIGHTDATA_JOBS_TIMEOUT_MS=45000
# Optional LinkedIn /in/ URLs (comma-separated) for Bright Data people enrichment
BRIGHTDATA_PEOPLE_SEED_URLS=
BRIGHTDATA_PEOPLE_DATASET_ID=gd_l1viktl72bvl7bjuj0
# Set to 1 to force demo people even when provider keys exist
PEOPLE_SOURCING_FORCE_DEMO=
